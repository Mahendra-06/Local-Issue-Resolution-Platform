# CivicPulse Frontend Environment Configuration
# Point this to your backend server (e.g., http://localhost:5000/api or https://api.civicpulse.org)
VITE_API_BASE_URL=http://localhost:5000/api

# OpenStreetMap & Routing Infrastructure
# Open Source Routing Machine (OSRM) driving route engine endpoint
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org

# Nominatim Geocoding & Reverse-Lookup endpoint
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
